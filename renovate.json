{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>showmino/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned as ARGs in the Dockerfile. Run ./update-checksums.sh on the PR: the SHA256 ARGs do not move with the version.",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\nARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.+)${{/if}}"
    }
  ]
}
